<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.swiesend</groupId>
        <artifactId>secret-service-parent</artifactId>
        <version>4.0.0-alpha</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>secret-service</artifactId>
    <packaging>jar</packaging>

    <name>secret-service</name>
    <description>
        A Java library for storing secrets in the gnome-keyring over the DBus.
        Simply set and get passwords in a gnome linux system.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.github.hypfvieh</groupId>
            <artifactId>dbus-java-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.hypfvieh</groupId>
            <artifactId>dbus-java-transport-native-unixsocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Mutation tests. No execution is bound: the Mutation tests workflow runs them
                 on the classes that a pull request changes, with
                 mvn -pl core test-compile org.pitest:pitest-maven:mutationCoverage -DtargetClasses=...
                 Without -DtargetClasses, PIT mutates every class of the module. -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <configuration>
                    <!-- Only tests that need no real provider: PIT runs them again for each
                         mutant, and a mutant must not reach a real keyring. A new test against
                         the fake provider belongs here. ModulePathTest does not: PIT runs the
                         tests on the class path. -->
                    <targetTests>
                        <!-- Against the fake provider, on a private bus of their own. -->
                        <param>de.swiesend.secretservice.integration.ConsentGateTest*</param>
                        <param>de.swiesend.secretservice.integration.DefaultCollectionScopingTest*</param>
                        <param>de.swiesend.secretservice.integration.DeleteItemsScopingTest*</param>
                        <param>de.swiesend.secretservice.integration.FakeSecretServiceTest*</param>
                        <param>de.swiesend.secretservice.integration.PerItemUnlockTest*</param>
                        <param>de.swiesend.secretservice.integration.PromptSuppressionTest*</param>
                        <param>de.swiesend.secretservice.integration.SlowProviderExistenceTest*</param>
                        <!-- Without D-Bus. -->
                        <param>de.swiesend.secretservice.HkdfTest*</param>
                        <param>de.swiesend.secretservice.LogPolicyTest*</param>
                        <param>de.swiesend.secretservice.functional.CollectionLockLogicTest*</param>
                        <param>de.swiesend.secretservice.functional.ConsentPolicyTest*</param>
                        <param>de.swiesend.secretservice.integration.SecretTest*</param>
                        <param>de.swiesend.secretservice.integration.StaticTest*</param>
                    </targetTests>
                    <outputFormats>
                        <param>XML</param>
                        <param>HTML</param>
                    </outputFormats>
                    <timestampedReports>false</timestampedReports>
                    <!-- A changed class with nothing to mutate, such as an interface without
                         a method body, is no failure. -->
                    <failWhenNoMutations>false</failWhenNoMutations>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
        No compiler configuration here on purpose. The release level is declared once, by the
        parent's <maven.compiler.release>, and inherited. Repeating release/source/target in
        every module means the next JDK bump has to find all of them, and a module that is missed
        silently keeps compiling to the old level.
    -->
</project>
